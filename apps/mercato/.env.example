# ==========================================
# Dermat India ERP & CRM — Environment Config
# ==========================================

# PostgreSQL Database Configuration
# Update host, port, user, password, and database name for your server
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dermat_india
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dermat_india

# JWT & Auth Secrets (Generate 32+ character random strings for production)
JWT_SECRET=dermat-india-erp-dev-secret-change-in-prod-1234567890abcdef
AUTH_SECRET=dermat-india-erp-auth-secret-change-in-prod-1234567890ab
NEXTAUTH_SECRET=

# Redis Transport
REDIS_URL=redis://localhost:6379

# Public Application URL
APP_URL=http://localhost:3000

# Onboarding & Demo Flags
DEMO_MODE=false
SELF_SERVICE_ONBOARDING_ENABLED=false

# Search Indexer (Meilisearch)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=meilisearch-dev-key

# Tenant Data Encryption Key (AES-256-GCM fallback key for encrypted PII and fields)
TENANT_DATA_ENCRYPTION_FALLBACK_KEY=wantace-erp-dev-encryption-key-32chars!!

# Feature Flags
OM_ENABLE_ENTERPRISE_MODULES=false
